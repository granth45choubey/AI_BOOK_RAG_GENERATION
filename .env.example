# ── Optional overrides (copy to .env to activate) ────────────────────────────

# Ollama server
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Embeddings
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BATCH_SIZE=64
OLLAMA_EMBED_TIMEOUT=300

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=rag_documents

# Chunking: "recursive" or "semantic"
CHUNK_STRATEGY=recursive
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retrieval
RETRIEVAL_TOP_K=5

# Upload
UPLOAD_DIR=./uploaded_docs

# Author documents
AUTHOR_UPLOAD_DIR=./author_docs
OUTLINE_STORE_PATH=./author_docs/chapter_outline.json
GENERATED_BOOK_STORE_PATH=./author_docs/generated_book.json

# Export Engine
EXPORTS_DIR=./exports

# Market / competitor analysis
COMPETITOR_COLLECTION_NAME=competitor_docs
COMPETITOR_UPLOAD_DIR=./competitor_docs
MAX_COMPETITOR_BOOKS=10

# Layered retrieval top-k
AUTHOR_TOP_K=3
COMPETITOR_TOP_K=2
GENERAL_TOP_K=3

# Generation performance
GENERATION_CHUNK_MAX_CHARS=320
LLM_NUM_PREDICT_FRAMEWORK=6144
LLM_NUM_PREDICT_GENERATION=2048
FRAMEWORK_CACHE_ENABLED=true
