# Virtual Environment
.venv/
venv/

# Python cache
__pycache__/
*.pyc

# Environment variables
.env

# Vector DB (runtime data — keep directory via .gitkeep)
chroma_db/*
!chroma_db/.gitkeep

# Uploaded files (runtime data — keep directory via .gitkeep)
uploaded_docs/*
!uploaded_docs/.gitkeep

# Generated author documents
author_docs/*
!author_docs/.gitkeep

# Competitor documents
competitor_docs/*
!competitor_docs/.gitkeep

# Generated exports
exports/*
!exports/.gitkeep

# macOS / Windows
.DS_Store
Thumbs.db

# Frontend
frontend/node_modules/
frontend/.next/
frontend/.env.local

# VS Code
.vscode/