# ── Optional overrides (copy to .env to activate) ────────────────────────────

# Ollama server
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# LLM routing (Option C)
LLM_PROVIDER=ollama
LLM_REASONING_MODEL=llama3.1:8b
LLM_LIGHT_MODEL=llama3.1:8b
LLM_API_BASE_URL=

# Embeddings
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=rag_documents

# Chunking: "recursive" or "semantic"
CHUNK_STRATEGY=recursive
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retrieval
RETRIEVAL_TOP_K=5

# Originality checks
ORIGINALITY_TOP_K=5
ORIGINALITY_THRESHOLD=0.85

# Upload
UPLOAD_DIR=./uploaded_docs

# Drafts
DRAFT_STORE_DIR=./drafts
